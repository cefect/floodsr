# syntax=docker/dockerfile:1.7

FROM us-docker.pkg.dev/colab-images/public/cpu-runtime:latest

# Add the small checkout toolchain without otherwise diverging from the managed Colab runtime.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Keep the image close to the managed Colab runtime and only pin the workflow shell defaults.
WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "-lc"]
