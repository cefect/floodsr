# syntax=docker/dockerfile:1.7

FROM condaforge/miniforge3:25.3.1-0

# Bake in the small toolchain needed by checkout and the notebook-capable install proofs.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

# Approximate a generic Unix Python environment with Jupyter already available.
RUN python -m pip install --no-cache-dir jupyterlab notebook ipykernel

WORKDIR /workspace

ENTRYPOINT ["/bin/bash", "-lc"]
